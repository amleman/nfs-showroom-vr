<!--
  Technical data sheet for the machine on the floor.

  Element ids consumed by SpecPanelSystem: spec-reference, dim-length,
  dim-width, dim-height, spec-N-label / spec-N-value for N in 0..6,
  metric-N-label / metric-N-value / metric-N-bar for N in 0..3, env-label,
  env-button.

  Every row is authored, always laid out, and blanked rather than hidden when a
  machine declares fewer than the maximum. Hiding a row would move the control
  row at the bottom of the panel, and a control that moves under the ray is a
  control you cannot click. That is also why env-button is the only button and
  sits alone in its own row.

  The three dimensions are measured off the fitted model at runtime, not quoted
  from the catalog, so what a visitor reads is the size of the object actually
  in front of them.

  Note: the <style> parser rejects /* */ comments outright.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 430px;
  }

  .block {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 12px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 2px;
    color: #0f62fe;
  }

  .eyebrow:dark {
    color: #6fa8ff;
  }

  .reference {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    color: #6b7280;
  }

  .reference:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .dim-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 14px;
  }

  .dim-cell {
    flex-direction: column;
    align-items: center;
    width: 118px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-radius: 8px;
    background-color: #eef1f6;
  }

  .dim-cell:dark {
    background-color: rgba(255, 255, 255, 0.07);
  }

  .dim-value {
    font-size: 19px;
    font-weight: 700;
    line-height: 22px;
    color: #1a1d21;
  }

  .dim-value:dark {
    color: rgba(255, 255, 255, 0.94);
  }

  .dim-caption {
    margin-top: 2px;
    font-size: 10px;
    font-weight: 700;
    line-height: 12px;
    letter-spacing: 1.4px;
    color: #6b7280;
  }

  .dim-caption:dark {
    color: rgba(255, 255, 255, 0.5);
  }

  .spec-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 5px;
  }

  .spec-label {
    font-size: 13px;
    font-weight: 400;
    line-height: 17px;
    color: #6b7280;
  }

  .spec-label:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .spec-value {
    font-size: 13px;
    font-weight: 700;
    line-height: 17px;
    text-align: right;
    color: #1a1d21;
  }

  .spec-value:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .metric-head {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 9px;
  }

  .metric-label {
    font-size: 12px;
    font-weight: 400;
    line-height: 15px;
    color: #6b7280;
  }

  .metric-label:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .metric-value {
    font-size: 12px;
    font-weight: 700;
    line-height: 15px;
    text-align: right;
    color: #1a1d21;
  }

  .metric-value:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .metric-track {
    height: 5px;
    width: 382px;
    margin-top: 3px;
    border-radius: 3px;
    background-color: #e2e6ed;
  }

  .metric-track:dark {
    background-color: rgba(255, 255, 255, 0.12);
  }

  .metric-bar {
    height: 5px;
    width: 0px;
    border-radius: 3px;
    background-color: #24a148;
  }

  .env-caption {
    margin-top: 2px;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    color: #6b7280;
  }

  .env-caption:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .controls {
    flex-direction: row;
    justify-content: center;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 10px;
    margin-bottom: 18px;
  }

  .env-button {
    width: 250px;
    justify-content: center;
  }

  .button-label {
    font-size: 13px;
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="block">
    <div class="eyebrow">FICHA TECNICA</div>
    <div id="spec-reference" class="reference">Clase Komatsu 930E-4</div>
    <div class="dim-row">
      <div class="dim-cell">
        <div id="dim-length" class="dim-value">15.5 m</div>
        <div class="dim-caption">LARGO</div>
      </div>
      <div class="dim-cell">
        <div id="dim-width" class="dim-value">9.0 m</div>
        <div class="dim-caption">ANCHO</div>
      </div>
      <div class="dim-cell">
        <div id="dim-height" class="dim-value">7.9 m</div>
        <div class="dim-caption">ALTO</div>
      </div>
    </div>
    <div class="spec-row">
      <div id="spec-0-label" class="spec-label">Capacidad de carga</div>
      <div id="spec-0-value" class="spec-value">290 t</div>
    </div>
    <div class="spec-row">
      <div id="spec-1-label" class="spec-label">Peso operativo</div>
      <div id="spec-1-value" class="spec-value">500 t</div>
    </div>
    <div class="spec-row">
      <div id="spec-2-label" class="spec-label">Capacidad de tolva</div>
      <div id="spec-2-value" class="spec-value">172 m3</div>
    </div>
    <div class="spec-row">
      <div id="spec-3-label" class="spec-label">Potencia</div>
      <div id="spec-3-value" class="spec-value">2 013 kW</div>
    </div>
    <div class="spec-row">
      <div id="spec-4-label" class="spec-label">Traccion</div>
      <div id="spec-4-value" class="spec-value">Electrica AC</div>
    </div>
    <div class="spec-row">
      <div id="spec-5-label" class="spec-label">Velocidad maxima</div>
      <div id="spec-5-value" class="spec-value">64.5 km/h</div>
    </div>
    <div class="spec-row">
      <div id="spec-6-label" class="spec-label">Neumaticos</div>
      <div id="spec-6-value" class="spec-value">59/80R63</div>
    </div>
  </div>
  <Divider></Divider>
  <div class="block">
    <div class="eyebrow">MONITOREO DE CONDICION (SIMULADO)</div>
    <div class="metric-head">
      <div id="metric-0-label" class="metric-label">Disponibilidad mecanica</div>
      <div id="metric-0-value" class="metric-value">91.4 %</div>
    </div>
    <div class="metric-track">
      <div id="metric-0-bar" class="metric-bar"></div>
    </div>
    <div class="metric-head">
      <div id="metric-1-label" class="metric-label">Horas desde servicio</div>
      <div id="metric-1-value" class="metric-value">412 / 500 h</div>
    </div>
    <div class="metric-track">
      <div id="metric-1-bar" class="metric-bar"></div>
    </div>
    <div class="metric-head">
      <div id="metric-2-label" class="metric-label">Desgaste de neumaticos</div>
      <div id="metric-2-value" class="metric-value">38 %</div>
    </div>
    <div class="metric-track">
      <div id="metric-2-bar" class="metric-bar"></div>
    </div>
    <div class="metric-head">
      <div id="metric-3-label" class="metric-label">Factor de carga</div>
      <div id="metric-3-value" class="metric-value">96 %</div>
    </div>
    <div class="metric-track">
      <div id="metric-3-bar" class="metric-bar"></div>
    </div>
  </div>
  <Divider></Divider>
  <div class="block">
    <div class="eyebrow">ENTORNO</div>
    <div id="env-label" class="env-caption">Galeria de Exhibicion</div>
  </div>
  <div class="controls">
    <Button id="env-button" class="env-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Cambiar entorno</ButtonLabel>
    </Button>
  </div>
</Panel>

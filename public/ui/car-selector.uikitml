<!--
  Showroom car selector. Panel, Divider, Button and ButtonLabel come from the
  bundled Horizon kit. No Lucide icons here: the bundled set ignores class- and
  attribute-based sizing and overflows a width-constrained button.

  Element ids consumed by CarSelectorSystem: car-name, car-position,
  prev-car, next-car.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 340px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 4px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 3px;
    color: #ff8a1e;
  }

  .car-name {
    margin-top: 8px;
    text-align: center;
    font-size: 26px;
    font-weight: 700;
    line-height: 30px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .car-name:dark {
    color: rgba(255, 255, 255, 0.94);
  }

  .car-position {
    margin-top: 4px;
    margin-bottom: 14px;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    color: #6b6b6b;
  }

  .car-position:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .controls {
    flex-direction: row;
    justify-content: space-between;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 14px;
    margin-bottom: 22px;
  }

  .nav-button {
    width: 92px;
    justify-content: center;
  }

  .nav-icon {
    width: 20px;
    height: 20px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">SHOWROOM</div>
    <div id="car-name" class="car-name">BMW M3 GTR</div>
    <div id="car-position" class="car-position">1 / 2</div>
  </div>
  <Divider></Divider>
  <div class="controls">
    <Button id="prev-car" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Prev</ButtonLabel>
    </Button>
    <Button id="spin-car" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Girar</ButtonLabel>
    </Button>
    <Button id="next-car" class="nav-button" variant="primary" size="sm">
      <ButtonLabel class="button-label">Next</ButtonLabel>
    </Button>
  </div>
</Panel>

<!--
  Inspection and occupational-safety points for the machine on the floor.

  Element ids consumed by InspectionPanelSystem: hot-0 .. hot-4 (and their
  labels hot-0-label .. hot-4-label), hot-kind, hot-title, hot-body.

  The button row is at the TOP of the panel on purpose. The detail text below it
  changes length with every selection, and a control row that moves under the
  ray is a control row you cannot click. Five buttons are always laid out; the
  ones a machine does not use are relabelled rather than hidden, for the same
  reason.

  The same points exist as markers on the machine itself. This panel is the
  guaranteed route to them: pointing at a ten-centimetre sphere from across a
  fifty-metre hall is not a skill a visitor should need.

  Note: the <style> parser rejects /* */ comments outright.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 500px;
  }

  .head {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 2px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 1.8px;
    color: #0b4fd4;
  }

  .eyebrow:dark {
    color: #6fa8ff;
  }

  .legend {
    margin-top: 5px;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    color: #3f4756;
  }

  .legend:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .controls {
    flex-direction: row;
    justify-content: space-between;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 12px;
    margin-bottom: 14px;
  }

  .hot-button {
    width: 82px;
    justify-content: center;
  }

  .button-label {
    font-size: 14px;
    transform-translate-y: 1px;
  }

  .detail {
    flex-direction: column;
    padding-top: 14px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 20px;
  }

  .hot-kind {
    font-size: 12px;
    font-weight: 700;
    line-height: 15px;
    letter-spacing: 1.6px;
    color: #d9700c;
  }

  .hot-title {
    margin-top: 5px;
    font-size: 23px;
    font-weight: 700;
    line-height: 27px;
    letter-spacing: -0.2px;
    color: #0d1014;
  }

  .hot-title:dark {
    color: rgba(255, 255, 255, 0.94);
  }

  .hot-body {
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
    line-height: 21px;
    color: #24292f;
  }

  .hot-body:dark {
    color: rgba(255, 255, 255, 0.72);
  }
</style>
<Panel class="panel-root">
  <div class="head">
    <div class="eyebrow">PUNTOS DE INSPECCION</div>
    <div class="legend">SSO seguridad / TEC tecnico / MTO mantenimiento</div>
  </div>
  <div class="controls">
    <Button id="hot-0" class="hot-button" variant="secondary" size="sm">
      <ButtonLabel id="hot-0-label" class="button-label">SSO 1</ButtonLabel>
    </Button>
    <Button id="hot-1" class="hot-button" variant="secondary" size="sm">
      <ButtonLabel id="hot-1-label" class="button-label">SSO 2</ButtonLabel>
    </Button>
    <Button id="hot-2" class="hot-button" variant="secondary" size="sm">
      <ButtonLabel id="hot-2-label" class="button-label">TEC 3</ButtonLabel>
    </Button>
    <Button id="hot-3" class="hot-button" variant="secondary" size="sm">
      <ButtonLabel id="hot-3-label" class="button-label">TEC 4</ButtonLabel>
    </Button>
    <Button id="hot-4" class="hot-button" variant="secondary" size="sm">
      <ButtonLabel id="hot-4-label" class="button-label">MTO 5</ButtonLabel>
    </Button>
  </div>
  <Divider></Divider>
  <div class="detail">
    <div id="hot-kind" class="hot-kind">SEGURIDAD Y SALUD OCUPACIONAL</div>
    <div id="hot-title" class="hot-title">Seleccione un punto</div>
    <div id="hot-body" class="hot-body">Toque un marcador sobre la maquina o un boton de esta lista para ver el criterio tecnico y de seguridad del punto.</div>
  </div>
</Panel>

<!--
  Machine selector. Panel, Divider, Button and ButtonLabel come from the bundled
  Horizon kit. No Lucide icons here: the bundled set ignores class- and
  attribute-based sizing and overflows a width-constrained button.

  Element ids consumed by MachineSelectorPanelSystem: machine-category,
  machine-name, machine-position, load-dot, prev-machine, turn-machine,
  cycle-machine, cycle-machine-label, next-machine.

  Two layout rules this panel exists under, both learned the hard way:

  - Every control is in ONE row. A button in a second row under the main row
    renders, and getElementById resolves it, but it never receives ray clicks.
  - load-dot is always laid out and only ever recolours. Toggling its display
    would move the button row, and a row that moves under the ray is a row you
    cannot click.

  Note: the <style> parser rejects /* */ comments outright and takes the whole
  level down with it.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 380px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 6px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 2px;
    text-align: center;
    color: #0f62fe;
  }

  .eyebrow:dark {
    color: #6fa8ff;
  }

  .machine-name {
    margin-top: 8px;
    text-align: center;
    font-size: 24px;
    font-weight: 700;
    line-height: 28px;
    letter-spacing: -0.4px;
    color: #1a1d21;
  }

  .machine-name:dark {
    color: rgba(255, 255, 255, 0.94);
  }

  .machine-position {
    margin-top: 6px;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.5px;
    color: #6b7280;
  }

  .machine-position:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .load-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-top: 10px;
    margin-bottom: 4px;
    background-color: #d4d7dd;
  }

  .controls {
    flex-direction: row;
    justify-content: space-between;
    margin-left: 18px;
    margin-right: 18px;
    margin-top: 14px;
    margin-bottom: 20px;
  }

  .nav-button {
    width: 78px;
    justify-content: center;
  }

  .button-label {
    font-size: 13px;
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="machine-category" class="eyebrow">MINERIA A CIELO ABIERTO</div>
    <div id="machine-name" class="machine-name">Camion Minero de Acarreo</div>
    <div id="machine-position" class="machine-position">1 / 7</div>
    <div id="load-dot" class="load-dot"></div>
  </div>
  <Divider></Divider>
  <div class="controls">
    <Button id="prev-machine" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Anterior</ButtonLabel>
    </Button>
    <Button id="turn-machine" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Girar</ButtonLabel>
    </Button>
    <Button id="cycle-machine" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel id="cycle-machine-label" class="button-label">Ciclo</ButtonLabel>
    </Button>
    <Button id="next-machine" class="nav-button" variant="primary" size="sm">
      <ButtonLabel class="button-label">Siguiente</ButtonLabel>
    </Button>
  </div>
</Panel>

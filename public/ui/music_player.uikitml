<!--
  Garage stereo controls. Panel, Divider, Button and ButtonLabel come from the
  bundled Horizon kit.

  Every control sits in ONE row on purpose: a Button in a second row below the
  main row renders and resolves fine but never receives ray clicks, which cost a
  long debugging session on the car selector.

  Element ids consumed by MusicPanelSystem: track-name, prev-track, play-pause,
  next-track, play-label.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 360px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 20px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 8px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 3px;
    color: #ff8a1e;
  }

  .track-name {
    margin-top: 8px;
    margin-bottom: 10px;
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 26px;
    letter-spacing: -0.3px;
    color: #272727;
  }

  .track-name:dark {
    color: rgba(255, 255, 255, 0.94);
  }

  .controls {
    flex-direction: row;
    justify-content: space-between;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 14px;
    margin-bottom: 22px;
  }

  .nav-button {
    width: 96px;
    justify-content: center;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">NOW PLAYING</div>
    <div id="track-name" class="track-name">Loading...</div>
  </div>
  <Divider></Divider>
  <div class="controls">
    <Button id="prev-track" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Prev</ButtonLabel>
    </Button>
    <Button id="play-pause" class="nav-button" variant="primary" size="sm">
      <ButtonLabel id="play-label" class="button-label">Pause</ButtonLabel>
    </Button>
    <Button id="next-track" class="nav-button" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Next</ButtonLabel>
    </Button>
  </div>
</Panel>

{
  "authoring": {
    "composition": {
      "assumptions": [
        {
          "certainty": "high",
          "id": "gallery-offset",
          "statement": "The exhibition gallery glTF is authored with its floor spanning x -7.2 to 43.3, so the node shifts it by -18 to centre the room on the origin and drops it 0.04 to put the floor at y=0."
        },
        {
          "certainty": "high",
          "id": "studio-scale",
          "statement": "The studio glTF is a 6.4 x 3.05 x 25 m corridor at 1:1, which cannot contain a 7.9 m haul truck. The node scales it 3.4 to a 21.8 m wide hall with 10.4 m of headroom, and re-centres the corridor (local -0.49, 2.62) on the origin."
        },
        {
          "certainty": "high",
          "id": "machine-scale",
          "statement": "Machines are not scaled here. MachineSwapperSystem fits each one to the real height declared in src/machine-catalog.ts, on the floor at the origin."
        },
        {
          "certainty": "medium",
          "id": "spawn-clearance",
          "statement": "The player spawns 16 m from the origin, which clears the rear of the longest machine (a 16.7 m haul truck yawed 24 degrees reaches z=9.6) by about 6 m and frames the whole of it."
        }
      ],

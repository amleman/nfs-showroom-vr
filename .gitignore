# Dependencies
node_modules/
.pnpm-debug.log*

# Build outputs
dist/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.production

# IDE and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
*.lcov

# Runtime and temporary data
pids/
*.pid
*.seed
*.pid.lock
.tmp/
.temp/
.iwsdk/

# MCP configs generated by the CLI
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
.codex/config.toml

# Music tracks. Kept out of the repo: they are commercial releases and ~105 MB,
# and this repository is public. Drop your own .mp3 files into
# public/audio/music/ and run `npm run music` to regenerate playlist.json.
public/audio/music/*.mp3
# Generated from whatever is in that folder by scripts/generate-playlist.mjs,
# which predev/prebuild run automatically.
public/audio/music/playlist.json

# Headset-sized models generated from public/gltf by scripts/optimize-models.mjs,
# which predev/prebuild run automatically. Derived output, like playlist.json:
# the sources next to them are what is versioned.
public/gltf/optimized/

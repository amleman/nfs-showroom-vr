<!--
  The inspection point's own card, shown floating beside the marker it belongs
  to rather than on the console across the hall.

  Element ids consumed by HotspotCardSystem: card-kind, card-title, card-body,
  card-machine.

  Deliberately has no controls. A visitor reads this with their face half a
  metre from a machine, and every button on it would be a button they have to
  aim at from there; the card closes by selecting another point, by turning the
  machine, or by changing equipment. That also means none of the layout rules
  about control rows apply here, so the body text is free to be as long as the
  point needs.

  Note: the <style> parser rejects /* */ comments outright.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .panel-root {
    flex-direction: column;
    font-family: "DM Sans";
    width: 380px;
  }

  .card {
    flex-direction: column;
    padding-top: 18px;
    padding-left: 22px;
    padding-right: 22px;
    padding-bottom: 20px;
  }

  .card-machine {
    font-size: 12px;
    font-weight: 700;
    line-height: 15px;
    letter-spacing: 1.6px;
    color: #6b7280;
  }

  .card-machine:dark {
    color: rgba(255, 255, 255, 0.45);
  }

  .card-kind {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 1.6px;
    color: #d9700c;
  }

  .card-title {
    margin-top: 5px;
    font-size: 25px;
    font-weight: 700;
    line-height: 29px;
    letter-spacing: -0.3px;
    color: #0d1014;
  }

  .card-title:dark {
    color: rgba(255, 255, 255, 0.96);
  }

  .card-body {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 500;
    line-height: 22px;
    color: #24292f;
  }

  .card-body:dark {
    color: rgba(255, 255, 255, 0.78);
  }
</style>
<Panel class="panel-root">
  <div class="card">
    <div id="card-machine" class="card-machine">CAMION MINERO DE ACARREO</div>
    <div id="card-kind" class="card-kind">SEGURIDAD Y SALUD OCUPACIONAL</div>
    <div id="card-title" class="card-title">Escalera de acceso</div>
    <div id="card-body" class="card-body">Tres puntos de apoyo obligatorios al subir y bajar.</div>
  </div>
</Panel>
